# Copy to .env and adjust. Nothing here is required for the default (in-memory, fake provider) setup.
AGENT_REPLAY_DATABASE_URL=postgresql://agent_replay:agent_replay@localhost:5432/agent_replay
# Set to require "Authorization: Bearer <token>" on POST /v1/traces.
AGENT_REPLAY_INGEST_TOKEN=change-me
# Capture prompts, tool arguments and results on spans (needed to rebuild replayable runs).
AGENT_REPLAY_CAPTURE_CONTENT=false
AGENT_REPLAY_LOG_LEVEL=INFO
# Require "Authorization: Bearer <token>" on the read API (/v1/trajectories, /v1/suites, /v1/diff).
AGENT_REPLAY_READ_TOKEN=change-me-too
# Optional real model provider for `record --llm env`, `gate --llm env` and `--judge env`.
# fake | openai | azure | ollama | anthropic. Leave as fake for tests, CI and the demo.
AGENT_REPLAY_LLM_PROVIDER=fake
AGENT_REPLAY_LLM_MODEL=
# Override the endpoint (Azure deployment URL, vLLM, a proxy). Ollama defaults to localhost:11434.
AGENT_REPLAY_LLM_BASE_URL=
# Or OPENAI_API_KEY / AZURE_OPENAI_API_KEY / ANTHROPIC_API_KEY for the matching provider.
AGENT_REPLAY_LLM_API_KEY=
AGENT_REPLAY_LLM_API_VERSION=2024-10-21
AGENT_REPLAY_LLM_TIMEOUT_S=60
AGENT_REPLAY_LLM_MAX_ATTEMPTS=3
