# Copy to .env and adjust. Nothing here is required for the default (in-memory, fake provider) setup.
AGENT_REPLAY_DATABASE_URL=postgresql://agent_replay:agent_replay@localhost:5432/agent_replay
# Set to require "Authorization: Bearer <token>" on POST /v1/traces.
AGENT_REPLAY_INGEST_TOKEN=change-me
# Capture prompts, tool arguments and results on spans (needed to rebuild replayable runs).
AGENT_REPLAY_CAPTURE_CONTENT=false
AGENT_REPLAY_LOG_LEVEL=INFO
